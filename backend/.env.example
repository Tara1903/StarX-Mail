# StarX Mail Backend Configuration

# Server Port
PORT=3000

# Environment: development | production | test
NODE_ENV=production

# Supabase Production Database & Storage Configuration
SUPABASE_URL=https://iotuxpcqewdzvqzncpad.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Secret key for JWT session tokens (32+ characters)
JWT_SECRET=your-random-32-character-jwt-secret

# Master AES-256 encryption key for credentials at rest
ENCRYPTION_KEY=your-random-32-character-encryption-key

# Backend public URL reachable by Resend webhooks and Android client
# For production: https://starx-mail-backend.vercel.app
BACKEND_PUBLIC_URL=https://starx-mail-backend.vercel.app

# Optional default Resend API Key (Can also be configured securely via Android app onboarding)
# RESEND_API_KEY=re_123456789

# Optional Webhook signing secret (auto-provisioned or from Resend dashboard)
# WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Optional Firebase Cloud Messaging Server Key / Service Account
# FCM_SERVER_KEY=your-fcm-server-key

# Data storage directory for fallback
DATA_DIR=./data

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
